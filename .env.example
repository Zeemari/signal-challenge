# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see .gitignore's *.local rule) — never commit real keys.

# Supabase project settings > API. These are read by BOTH the browser (via
# import.meta.env, hence the VITE_ prefix) and the serverless functions in /api
# (via process.env — Node reads any env var regardless of prefix).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic API key. Server-only — used in /api functions, never exposed to
# the browser since it has no VITE_ prefix.
ANTHROPIC_API_KEY=
